# 複製成 .env.local 後填入實際值。正式環境在 Vercel 的
# Settings → Environment Variables 設定，改動後需重新部署才會生效。

# --- 詢問單與電子報寫入 Google 試算表；設定步驟見 docs/enquiries.md ---
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# --- /admin 的 GitHub 登入；設定步驟見 docs/cms.md ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# 允許發起登入的主機，不含 https:// 與結尾斜線，多個以逗號分隔
GITHUB_OAUTH_ALLOWED_HOSTS=

# --- 選填 ---
# Open Graph 圖片等絕對網址的基準。在 Vercel 上留空即可，會自動採用
# VERCEL_PROJECT_PRODUCTION_URL；接上自訂網域後再填入該網域。
NEXT_PUBLIC_SITE_URL=
